// Regression fixture - invalid/type_errors - LogicalAndOperands
//
// `&&` was the one operator whose result type the rules table fixed without
// looking at its operands, so the checker accepted anything: `true &&
// voidCall()` passed here and only blew up in lowering as an unlowerable
// condition (an unbound local, a stubbed function), and `1 && 2` compiled on
// this path but silently evaluated to `true` on the reference path - the same
// source program with two different meanings.
//
// The runtime requires bool operands, so the checker does too. `||` is checked
// by the same line; see LogicalOrOperands.zl.

class LogicalAndOperands {
    public func probe(): void {
        log(1 && 2)
    }

    func main(): void {
        new LogicalAndOperands().probe()
    }
}
