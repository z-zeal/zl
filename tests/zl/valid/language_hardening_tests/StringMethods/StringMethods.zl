// ============================================================================
// Regression fixture - valid/language_hardening_tests - StringMethods
//
// `string` has methods, and every one of them is an existing String.* native
// primitive: the receiver binds the native's first parameter and the call's
// arguments bind the rest, so `s.length()` and `String.length(s)` reach the
// same catalog entry. Most checks below compare the two spellings directly -
// pinning only the return value would pass even if the method surface drifted
// into a second implementation.
//
// Indexing stays the byte boundary, exactly like String.*; the utf8* methods
// are the scalar-indexed ones that Text.* wraps with parsing conveniences.
// `split` returns the native list storage for the same reason String.split
// does, so it is read back through Collection.*.
//
// The receiver helpers live in this case's directory, one primary type per
// file: StringMethodBox.zl (a string field as receiver) and StringMethodTag.zl
// (a generic instantiation's body). The entry imports both by name.
// ============================================================================

import zl.text.Text

import StringMethodBox
import StringMethodTag

class StringMethods {
    func check(bool cond, string what): void {
        if (!cond) {
            throw new Exception("StringMethods failed: " + what)
        }
    }

    func corpus(): List<string> {
        var names = new List<string>()
        names.push("Ada")
        names.push("Grace")
        return names
    }

    func joined(string left, string right): string {
        return left + right
    }

    func main(): void {
        var self = new StringMethods()
        var s = "Hello, World"
        var e = "h" + "é" + "llo"          // five scalars, six bytes

        // --- the byte boundary, each against its qualified spelling ---------
        self.check(s.length() == String.length(s), "length agrees with String.length")
        self.check(s.length() == 12, "length counts bytes")
        self.check(e.length() == 6, "a two-byte scalar is two String bytes")

        self.check(s.upper() == String.upper(s), "upper agrees")
        self.check(s.lower() == String.lower(s), "lower agrees")
        self.check("  pad  ".trim() == String.trim("  pad  "), "trim agrees")
        self.check("  pad  ".trimStart() == "pad  ", "trimStart strips on the left")
        self.check("  pad  ".trimEnd() == "  pad", "trimEnd strips on the right")

        self.check(s.contains("World") == String.contains(s, "World"), "contains agrees")
        self.check(s.contains("world") == false, "contains compares bytes, so case matters")

        self.check(s.startsWith("Hello") == String.startsWith(s, "Hello"), "startsWith agrees")
        self.check(s.endsWith("World") == String.endsWith(s, "World"), "endsWith agrees")
        self.check(s.startsWith("World") == false, "startsWith is a prefix test")
        self.check(s.endsWith("Hello") == false, "endsWith is a suffix test")
        self.check(s.startsWith("Hello, World and more") == false, "a longer prefix does not match")
        self.check("".startsWith("") && "".endsWith("") && "".contains(""), "the empty string is a prefix, suffix and substring of itself")

        self.check(s.indexOf("World") == String.indexOf(s, "World"), "indexOf agrees")
        self.check(s.indexOf("nope") == -1, "a miss is -1, not an error")
        self.check(s.lastIndexOf("o") == String.lastIndexOf(s, "o"), "lastIndexOf agrees")
        self.check(s.indexOfFrom("o", 5) == String.indexOfFrom(s, "o", 5), "indexOfFrom agrees")

        self.check(s.charAt(1) == String.charAt(s, 1), "charAt agrees")
        self.check(s.charAt(1) == "e", "charAt indexes bytes")
        self.check(s.substring(0, 5) == String.substring(s, 0, 5), "substring agrees")
        self.check(s.replace("World", "ZL") == String.replace(s, "World", "ZL"), "replace agrees")
        self.check(s.codePointAt(0) == String.codePointAt(s, 0), "codePointAt agrees")
        self.check("ab".repeatText(3) == String.repeatText("ab", 3), "repeatText agrees")
        self.check("ab".repeatText(3) == "ababab", "repeatText repeats")

        self.check("42".toInt() == String.toInt("42"), "toInt agrees")
        self.check("42".toInt() == 42, "toInt parses")
        self.check("2.5".toFloat() == String.toFloat("2.5"), "toFloat agrees")
        self.check(s.compare("Hello, World!") == String.compare(s, "Hello, World!"), "compare agrees")
        self.check(s.compare(s) == 0, "compare against itself is zero")
        self.check(s.compareIgnoreCase("hello, WORLD") == 0, "compareIgnoreCase ignores ASCII case")

        // --- the scalar-indexed half -----------------------------------------
        self.check(e.utf8Length() == 5, "utf8Length counts scalars")
        self.check(e.utf8CharAt(1) == String.utf8CharAt(e, 1), "utf8CharAt agrees")
        self.check(e.utf8CharAt(1) == "é", "utf8CharAt keeps a scalar whole")
        self.check(e.utf8Substring(0, 2) == String.utf8Substring(e, 0, 2), "utf8Substring agrees")
        self.check(e.utf8Reverse() == String.utf8Reverse(e), "utf8Reverse agrees")
        self.check(e.utf8Reverse() == "olléh", "utf8Reverse keeps multi-byte scalars intact")
        self.check(e.utf8CodePointAt(1) == String.utf8CodePointAt(e, 1), "utf8CodePointAt agrees")
        self.check(e.utf8CodePointAt(1) == 233, "utf8CodePointAt reads the scalar")
        self.check(e.utf8ByteIndex(1) == String.utf8ByteIndex(e, 1), "utf8ByteIndex agrees")
        self.check(e.utf8IndexFromByte(1) == String.utf8IndexFromByte(e, 1), "utf8IndexFromByte agrees")

        // --- a split returns String.split's native list storage --------------
        var parts = s.split(", ")
        self.check(Collection.length(parts) == Collection.length(String.split(s, ", ")), "split agrees")
        self.check(Collection.length(parts) == 2, "split found two pieces")
        self.check(Collection.get(parts, 1) == "World", "split kept the second piece")

        // --- receivers that are not a plain local ----------------------------
        self.check(("a" + "b").length() == 2, "a concatenation result has methods")
        self.check(self.joined("ab", "cd").substring(1, 3) == "bc", "a call result has methods")
        self.check(self.corpus().get(0).upper() == "ADA", "a list element has methods")
        self.check(s.substring(0, 5).lower().contains("hello"), "calls chain")
        self.check(s.trim().substring(0, 5).lower() == "hello", "a chained call keeps its type")
        self.check("7".toInt() + 1 == 8, "toInt returns an int, not a string")

        // A method call is an ordinary expression: it can be an argument, a
        // condition, and a lambda body.
        self.check(Text.startsWith(s, "Hello"), "Text.startsWith still works")
        self.check(Text.endsWith(s.lower(), "world"), "Text.endsWith still works")
        if (s.trim().endsWith("World")) {
            self.check(true, "a method call works as a condition")
        } else {
            self.check(false, "a method call works as a condition")
        }
        // A typed lambda parameter carries the type a string method needs;
        // an untyped `func(name)` parameter is UNKNOWN and stays outside the
        // surface (see TASKS.md P1-2 on bare func signatures).
        self.corpus().forEach(func(string name) => self.check(name.length() > 0, "typed lambda parameter"))

        // A field receiver, read and written.
        var box = new StringMethodBox("  boxed text  ")
        self.check(box.text.trim() == "boxed text", "a string field has methods")
        box.text = "replaced"
        self.check(box.text.startsWith("repl") && box.text.length() == 8, "a written field has methods")

        // A generic instantiation's body, twice, with different type arguments.
        var taggedInt = new StringMethodTag<int>("  alpha  ")
        var taggedDouble = new StringMethodTag<double>("beta")
        self.check(taggedInt.label() == "ALPHA/9", "a generic instantiation resolves the surface")
        self.check(taggedDouble.label() == "BETA/4", "and a second instantiation resolves it identically")

        // Mutating a local between calls is not cached anywhere.
        var mutable = "  one  "
        self.check(mutable.trim() == "one", "trim of the first value")
        mutable = "  two  "
        self.check(mutable.trim() == "two", "trim of the second value")

        log("ok")
    }
}
