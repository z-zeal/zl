// Regression fixture - valid/language_hardening_tests - ForInList
// `for value in list<T>` iterates the typed native list in order. The source
// expression is evaluated once and its initial length is captured before the
// loop; break/continue retain their regular loop behavior.

class ForInList {
    int makeCalls = 0

    func makeNumbers(): list<int> {
        this.makeCalls = this.makeCalls + 1
        return [2, 4, 6, 8]
    }

    func main(): void {
        var self = new ForInList()
        var total = 0
        var count = 0
        for value in self.makeNumbers() {
            total += value
            count += 1
            if (value == 4) { continue }
            if (value == 8) { break }
        }
        if (total != 20 || count != 4) {
            throw new Exception("ForInList failed: loop values or control flow")
        }
        if (self.makeCalls != 1) {
            throw new Exception("ForInList failed: collection expression evaluated more than once")
        }

        list<string> words = ["a", "b", "c"]
        var joined = ""
        for word in words {
            joined += word
        }
        if (joined != "abc") {
            throw new Exception("ForInList failed: element type inference")
        }

        list<int> empty = []
        var emptyCount = 0
        for item in empty {
            emptyCount += item
        }
        if (emptyCount != 0) {
            throw new Exception("ForInList failed: empty list")
        }

        // The high-level List<T> wrapper is equally iterable; its backing
        // native list stays an implementation detail of the lowering.
        var wrapped = new List<int>()
        wrapped.push(3)
        wrapped.push(5)
        var wrappedTotal = 0
        for wrappedValue in wrapped {
            wrappedTotal += wrappedValue
        }
        if (wrappedTotal != 8) {
            throw new Exception("ForInList failed: List<T> wrapper iteration")
        }
        log("ok")
    }
}
